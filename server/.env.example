# FHIR Server 環境（前端可透過 X-FHIR-Env header 切換）
FHIR_URL_TWCORE=https://twcore.hapi.fhir.tw/fhir
FHIR_URL_HAPI_ORG=https://hapi.fhir.org/baseR4
# 未指定 X-FHIR-Env 時的預設環境：twcore | hapi-org
FHIR_ENV=twcore
PORT=3000
# 預留：未來啟用驗證時填入（見 fhirClient.js auth 擴充點）
# FHIR_AUTH_TOKEN=

# 未指定 X-FHIR-IG 時的預設 IG：tw-core | r4-base（v4）
FHIR_IG=tw-core

# Gateway 自身鑑權（v4）：未設定時 /api 完全開放；設定後每個請求需帶
# 對應的 X-Gateway-Key header
# GATEWAY_API_KEY=
